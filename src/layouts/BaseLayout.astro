---
import '../styles/global.css';
import '../styles/themes.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Christian Talavera | Platform & Cloud Infrastructure',
  description = 'Infrastructure engineering, Linux, automation, GitOps, networking, and open-source contributions.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="github">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Christian Talavera" />
    <meta name="theme-color" content="#0d1117" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://ctalaveraw.github.io/" />

    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fira+Code:wght@400;500&display=swap"
    />

    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&display=swap"
    />

    <script is:inline>
      try {
        const saved = localStorage.getItem('portfolio-theme');
        if (
          [
            'hophni',
            'github',
            'catppuccin',
            'nord',
            'gruvbox',
            'dracula',
            'tokyo-night',
            'one-dark',
            'solarized-dark',
            'rose-pine',
            'everforest',
            'monokai',
            'ayu-mirage',
            'custom',
          ].includes(saved)
        ) {
          document.documentElement.dataset.theme = saved;

          if (saved === 'custom') {
            const colors = JSON.parse(localStorage.getItem('portfolio-custom-colors') || '{}');

            const allowed = new Set([
              '--color-bg-dark',
              '--color-ide-gray',
              '--color-ide-border',
              '--color-ide-status',
              '--color-primary',
              '--color-accent-green',
              '--color-foreground',
              '--color-syntax-keyword',
              '--color-syntax-string',
              '--color-syntax-comment',
            ]);

            for (const [token, value] of Object.entries(colors)) {
              if (
                allowed.has(token) &&
                typeof value === 'string' &&
                /^#[0-9a-f]{6}$/i.test(value)
              ) {
                document.documentElement.style.setProperty(token, value);
              }
            }
          }
        }
      } catch {
        // Storage unavailable; use the default GitHub theme.
      }
    </script>
  </head>

  <body>
    <slot />
  </body>
</html>
