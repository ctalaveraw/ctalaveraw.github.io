---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProjectCards from '../components/ProjectCards.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import Footer from '../components/Footer.astro';
import HiddenTerminal from '../components/HiddenTerminal.astro';
---

<BaseLayout>
  <Header />

  <main class="max-w-6xl mx-auto px-5 py-12 space-y-20">
    <Hero />
    <ProjectCards />

    <section class="border border-ide-border rounded-lg p-6 bg-ide-gray/30">
      <h2 class="font-mono text-lg font-semibold mb-3">Further reading</h2>

      <p class="text-sm text-gray-400 mb-4">
        The repositories contain implementation details, test results, design decisions, and work
        still in progress.
      </p>

      <div class="flex flex-wrap gap-4 text-sm font-mono">
        <a
          class="text-primary hover:underline"
          href="https://github.com/ctalaveraw/arm-homelab-platform/blob/main/docs/interview/engineering-evidence.md"
        >
          Platform evidence
        </a>

        <a
          class="text-primary hover:underline"
          href="https://github.com/ctalaveraw/arm-homelab-platform/blob/main/docs/architecture/overview.md"
        >
          Architecture
        </a>

        <a
          class="text-primary hover:underline"
          href="https://github.com/ctalaveraw/arm-homelab-platform/blob/main/docs/roadmap.md"
        >
          Roadmap
        </a>
      </div>
    </section>

    <ExperienceTimeline />
  </main>

  <Footer />
  <HiddenTerminal />
</BaseLayout>
