---
import { getCollection } from 'astro:content';

const entries = await getCollection('contacts');
const contact = entries[0]?.data;
---

<section id="contact" class="max-w-6xl mx-auto px-5 pb-24">
  <div class="border border-ide-border rounded-lg bg-ide-gray/30 p-6">
    <h2 class="font-mono text-xl font-semibold mb-3">contact.sh</h2>

    <p class="text-sm text-gray-400 mb-5">Repository links and upstream OpenWrt pull requests.</p>

    <div class="flex flex-wrap gap-3">
      {(contact?.links ?? []).map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="border border-ide-border rounded px-3 py-2 text-sm font-mono hover:border-primary hover:text-primary"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</section>

<footer
  id="portfolio-status"
  class="fixed bottom-0 inset-x-0 z-50 bg-ide-status border-t border-ide-border h-8 px-2 sm:px-4 flex items-center gap-3 text-[11px] font-mono"
>
  <div class="flex min-w-0 shrink-0 items-center gap-2">
    <span class="rounded-sm bg-primary px-2 py-1 font-semibold text-bg-dark">0:portfolio*</span>
    <span class="hidden md:inline text-gray-400">public session</span>
  </div>

  <div class="ml-auto flex min-w-0 items-center gap-3">
    <span class="min-w-0 truncate text-gray-400">
      theme:{' '}
      <span id="status-theme" class="text-foreground">
        GitHub
      </span>
    </span>

    <button
      id="open-portfolio-terminal-status"
      type="button"
      title="Open portfolio console (Ctrl+K)"
      aria-label="Open portfolio console"
      class="shrink-0 rounded border border-ide-border px-2 py-0.5 text-primary hover:border-primary focus-visible:outline-offset-2"
    >
      ^K <span class="hidden sm:inline">console</span>
    </button>

    <a
      href="https://github.com/HoPHNiDev/hophni.dev"
      target="_blank"
      rel="noopener noreferrer"
      class="hidden lg:inline shrink-0 text-primary hover:underline"
    >
      HoPHNi
    </a>
  </div>
</footer>

<script src="../scripts/statusTheme.ts"></script>
