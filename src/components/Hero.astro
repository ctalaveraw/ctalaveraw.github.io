---
import { getCollection } from 'astro:content';

const entries = await getCollection('hero');
const profile = entries[0]?.data;

const role = profile?.role ?? 'Infrastructure Engineer';
const bio = profile?.bio ?? '';
const skills = profile?.skills ?? {};
---

<section id="about" class="pt-8">
  <div class="max-w-4xl mx-auto border border-ide-border rounded-lg overflow-hidden bg-bg-dark shadow-2xl">
    <div class="bg-ide-gray border-b border-ide-border px-4 py-3 flex items-center gap-2">
      <span class="terminal-dot bg-[#ff5f56]"></span>
      <span class="terminal-dot bg-[#ffbd2e]"></span>
      <span class="terminal-dot bg-[#27c93f]"></span>

      <span class="ml-4 font-mono text-xs text-gray-400">~/chris/portfolio</span>
    </div>

    <div class="p-6 md:p-8 font-mono text-sm leading-relaxed">
      <div class="text-primary mb-2">$ whoami</div>

      <h1 class="text-2xl md:text-3xl font-bold mb-2">Christian Talavera</h1>

      <p class="text-accent-green text-base md:text-lg mb-7">{role}</p>

      <div class="text-primary mb-2">$ cat about.md</div>
      <p class="text-gray-300 max-w-3xl leading-7 mb-7">{bio}</p>

      <div class="text-primary mb-3">$ cat skills.json</div>

      <div class="grid md:grid-cols-2 gap-x-8 gap-y-3">
        {Object.entries(skills).map(([group, technologies]) => (
          <div>
            <span class="text-syntax-keyword">{group}</span>
            <span class="text-gray-400">: </span>
            <span class="text-syntax-string">{(technologies as string[]).join(', ')}</span>
          </div>
        ))}
      </div>

      <div class="mt-7 flex flex-wrap items-center gap-3 font-mono text-sm">
        <span class="text-primary">$</span>
        <button
          id="open-portfolio-terminal-hero"
          type="button"
          class="rounded border border-ide-border px-3 py-2 text-primary hover:border-primary"
        >
          open console
        </button>
        <span class="text-gray-400 text-xs">Ctrl+K / Cmd+K</span>
      </div>
    </div>
  </div>
</section>
