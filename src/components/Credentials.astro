---
import { certifications, education } from '../data/credentials';
---

<section id="credentials" class="space-y-6" aria-labelledby="credentials-title">
  <div class="flex items-center gap-4">
    <h2 id="credentials-title" class="text-2xl font-bold font-mono">Credentials.md</h2>
    <div class="h-px flex-1 bg-ide-border"></div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
    <div class="lg:col-span-2 rounded-lg border border-ide-border bg-ide-gray/40 p-5">
      <h3 class="font-mono text-sm text-primary mb-4">Certifications earned</h3>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
        {certifications.map((cert) => (
          <li class="min-w-0 rounded border border-ide-border bg-bg-dark p-3">
            <span class="block text-sm text-foreground">{cert.name}</span>
            {'detail' in cert && <span class="mt-1 block font-mono text-xs text-gray-400">{cert.detail}</span>}
          </li>
        ))}
      </ul>
    </div>
    <div class="rounded-lg border border-ide-border bg-ide-gray/40 p-5">
      <h3 class="font-mono text-sm text-primary mb-4">Education</h3>
      <p class="text-sm text-foreground">{education.program}</p>
      <p class="mt-2 text-sm text-gray-400">{education.institution}</p>
      <p class="mt-4 font-mono text-xs text-accent-green">{education.status}</p>
    </div>
  </div>
</section>
